# ───────────── Frontend (public — bundled into the browser) ─────────────
# Mapbox public token (pk.*). Restrict it to your portal's URL in the Mapbox dashboard.
VITE_MAPBOX_ACCESS_TOKEN=
# Optional GeoServer for your own WMS/WFS layers, e.g. http://localhost:8080/geoserver
VITE_GEOSERVER_URL=
# Optional — base URL of the backend. Leave empty to use same-origin /api (recommended).
VITE_API_BASE_URL=

# ───────────── Backend (server/index.js — never exposed to the browser) ─────────────
# Google Gemini key for Explain / Simplify / Translate / Assistant.
# Create at https://aistudio.google.com/apikey. Without it the offline guide is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Tried in order if the main model is busy (503) or unavailable
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-2.5-flash
API_PORT=8787
# Comma-separated origins allowed to call the API in production (empty = same-origin only)
ALLOWED_ORIGINS=
